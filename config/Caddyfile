:80 {
    root * /home/atsushi/site
    file_server

    header /js/* Cache-Control "no-cache, must-revalidate"
    header /css/* Cache-Control "no-cache, must-revalidate"

    respond /_/* 403
    respond /api/admins/* 403

    reverse_proxy /api/* 127.0.0.1:8090

    # /altcha/challenge — static PoW challenge served by Caddy (client-side only).
    # No HMAC signature; widget accepts it because hmackey is not set on the element.
    # Replace with reverse_proxy to a Pi service when server-side verification is added.
    # (Removed: reverse_proxy /altcha/* 127.0.0.1:3000 — Altcha no longer self-hosted)
    handle /altcha/challenge {
        header Content-Type "application/json"
        respond `{"algorithm":"SHA-256","challenge":"a665a45920422f9d417e4867efdc4fb8a04a1f3fff1fa07e998e86f7f7a27ae3","maxnumber":10000,"salt":"altcha2026","signature":""}`
    }

    handle /ram {
        reverse_proxy 127.0.0.1:8091
    }
}
