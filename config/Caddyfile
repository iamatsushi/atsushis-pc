:80 {
    root * /home/atsushi/site
    file_server

    header /js/* Cache-Control "no-cache, must-revalidate"
    header /css/* Cache-Control "no-cache, must-revalidate"

    respond /_/* 403
    respond /api/admins/* 403

    reverse_proxy /api/* 127.0.0.1:8090
    reverse_proxy /altcha/* 127.0.0.1:3000

    handle /ram {
        reverse_proxy 127.0.0.1:8091
    }
}
