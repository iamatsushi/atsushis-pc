:80 {
    root * /home/atsushi/site
    file_server

    header /js/* Cache-Control "no-cache, must-revalidate"
    header /css/* Cache-Control "no-cache, must-revalidate"

    respond /_/* 403
    respond /api/admins/* 403

    reverse_proxy /api/* 127.0.0.1:8090

    # /altcha/challenge — proxied to altcha-server.py (127.0.0.1:8093).
    # Generates a fresh HMAC-signed challenge per request using ALTCHA_HMAC_SECRET.
    handle /altcha/challenge {
        reverse_proxy 127.0.0.1:8093
    }

    handle /ram {
        reverse_proxy 127.0.0.1:8091
    }
}
