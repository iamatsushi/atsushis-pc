# REFERENCE COPY — live file is /etc/caddy/Caddyfile on the Pi.
# Sync manually after any edit:
#   scp config/Caddyfile atsushispc:/etc/caddy/Caddyfile
#   ssh atsushispc 'sudo systemctl reload caddy'

:80 {
    root * /home/atsushi/site
    file_server

    header Content-Security-Policy "script-src 'self' 'unsafe-inline' https://cloud.umami.is https://cdn.jsdelivr.net"

    header /js/* Cache-Control "no-cache, must-revalidate"
    header /css/* Cache-Control "no-cache, must-revalidate"

    respond /_/* 403
    respond /api/admins/* 403

    reverse_proxy /api/* 127.0.0.1:8090

    # /altcha/challenge — proxied to altcha-server.py (127.0.0.1:8093).
    # Generates a fresh HMAC-signed challenge per request using ALTCHA_HMAC_SECRET.
    handle /altcha/challenge {
        reverse_proxy 127.0.0.1:8093
    }

    handle /ram {
        reverse_proxy 127.0.0.1:8091
    }

    handle /weather {
        reverse_proxy 127.0.0.1:8092
    }

    handle_errors {
        @404 expression `{err.status_code} == 404`
        rewrite @404 /404.html
        file_server
    }
}
